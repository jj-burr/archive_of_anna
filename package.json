{
  "name": "archive_of_anna",
  "version": "0.2.0",
  "description": "Unofficial Anna's Archive API written in JS.",
  "main": "index.js",
  "keywords": [
    "annas_archive",
    "zlibrary",
    "api",
    "books",
    "ebooks",
    "book",
    "ebook",
    "z-lib",
    "library",
    "1lib",
    "shadow library"
  ],
  "scripts": {
    "start": "node web/server.js",
    "test": "nyc --reporter=html --check-coverage --lines 90 --per-file mocha \"test/unit/**/*.js\" test/verify-integration.js --recursive --timeout=10000 --exit --reporter mocha-junit-reporter --reporter-options mochaFile=reports/mocha/test-results.xml",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:all": "npm test && npm run test:e2e",
    "lint": "eslint '**/*.js'"
  },
  "author": "Tejas Shetty",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.1.2",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "chai": "^4.3.6",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "mocha": "^10.1.0",
    "mocha-junit-reporter": "^2.1.1",
    "nyc": "^15.1.0",
    "sinon": "^21.0.1"
  }
}
